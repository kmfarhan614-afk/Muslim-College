# ---------------------------------------------------------------------------
# Muslim Commerce College Peshawar - Attendance Management System
# Supabase connection + server configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings -> API keys).
#
# server.js reads `.env.local` itself (zero dependency). Without
# SUPABASE_SERVICE_ROLE_KEY the app runs in local-only mode.
# Never commit real keys.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Server-only secret. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in. Required in production: server.js refuses to start with
# NODE_ENV=production while ADMIN_PASSWORD is unset or still "admin123".
ADMIN_EMAIL=admin@college.com
ADMIN_PASSWORD=

# Server
PORT=3000
HOST=
DATA_DIR=
NODE_ENV=

# Base URL of the deployed application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
