# ---------------------------------------------------------------------------
# Muslim Commerce College Peshawar - Attendance Management System
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real keys or passwords.
# ---------------------------------------------------------------------------

# --- Optional: Supabase (permanent storage) --------------------------------
# Project Settings -> API keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Server-only secret key. Required to enable Supabase writes from server.js.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin sign-in (required in production) --------------------------------
# Local development falls back to admin@college.com / admin123.
# server.js refuses to start with NODE_ENV=production while ADMIN_PASSWORD is
# unset or still equals admin123.
ADMIN_EMAIL=admin@college.com
ADMIN_PASSWORD=

# --- Server -----------------------------------------------------------------
PORT=3000
# 127.0.0.1 locally; 0.0.0.0 on a container/PaaS (automatic when NODE_ENV=production)
HOST=
# Optional override for the runtime data directory (default: ./data)
DATA_DIR=
# Set to "production" on the deployed host. Enables the admin-password guard.
NODE_ENV=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
